{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "features/**/*.ts",
    "pages/**/*.ts",
    "steps/**/*.ts",
    "support/**/*.ts"
  ]
}